{
  "name": "cse-210-warm-up-graphing",
  "version": "1.0.0",
  "private": true,
  "description": "A graphing tool for CSE 210.",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "test:coverage": "node coverage-ratchet.js",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "22.20.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  }
}
