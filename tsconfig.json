// Type checks the JavaScript and its JSDoc with `npm run typecheck`. Nothing is
// emitted; the app still runs the .js files directly.
{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    // TypeScript 7 turns strict on by default. Most of the code has no JSDoc
    // types yet, so strict mode would fail on every untyped parameter.
    "strict": false,
    "target": "es2022",
    "module": "preserve",
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["**/*.js"],
  // Not source code: dependencies and Playwright output.
  "exclude": ["node_modules", "test-results"]
}
